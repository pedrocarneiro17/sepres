# Variáveis de ambiente do Sistema DP
# No Railway: configure em "Variables". Localmente: copie para ".env".

# Chave usada para assinar as sessões. Gere uma aleatória e longa.
# Ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Fornecida automaticamente pelo Railway ao vincular o banco PostgreSQL.
# Se ausente, o sistema usa um arquivo SQLite local (apenas para desenvolvimento).
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# Envio do e-mail de recuperação de senha (SMTP). Sem SMTP_HOST, o link de redefinição
# só é escrito no log. No Gmail, use uma "senha de app" (exige verificação em duas etapas).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=conta-do-sistema@gmail.com
# SMTP_PASSWORD=senha-de-app-de-16-letras
# SMTP_FROM=Sistema DP SEPRES <conta-do-sistema@gmail.com>

# Endereço público do sistema (usado nos links enviados por e-mail).
# APP_URL=https://seu-app.up.railway.app

# Os usuários NÃO vêm de variáveis de ambiente: crie-os com
#   python criar_usuario.py <nome> <email> <senha>
